{
  // Cloudflare Workers konfiguratsiyasi.
  // Statik sayt "public/" papkasidan beriladi, /api/* so'rovlari esa src/worker.js ga keladi.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chiziqli",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "QuizRoom" },
      { "name": "ACCOUNTS", "class_name": "Accounts" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["QuizRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["Accounts"] }
  ],
  "observability": { "enabled": true }
}
